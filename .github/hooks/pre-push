#!/bin/sh
# HackBridge Pre-push Hook
# Blocks broken pushes by running the self-fixing test loop first.

echo "=========================================="
echo "Running HackBridge pre-push test loop..."
echo "=========================================="

npm run test:loop
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "✖ Push rejected: All tests must pass before pushing to remote."
  echo "✖ See test-results/FAILURES.md for details."
  exit 1
fi

echo "✔ All tests passing. Proceeding with push."
exit 0
