# HackBridge Environment Variables

# Database: SQLite for instant local zero-dependency development/test, or PostgreSQL for production
DATABASE_URL="file:./dev.db"
# Production Postgres Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackbridge?schema=public"

# Auth & Security
JWT_SECRET="hackbridge-super-secret-jwt-key-minimum-32-chars-long!"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay Integration (Test / Live)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_key_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_key"

# GitHub REST API Integration
GITHUB_ORG_NAME="hackbridge-teams"
GITHUB_ACCESS_TOKEN="ghp_placeholder_token_for_repo_generation"

# S3 Compatible File Storage
S3_ENDPOINT=""
S3_BUCKET="hackbridge-storage"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HackBridge <noreply@hackbridge.dev>"
